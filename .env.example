# ============================================
# GeorgiaTrips Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Stripe Configuration ----
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Firebase Admin SDK ----
# Option 1: Path to service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Inline JSON string (for cloud hosting like Render.com)
# Paste the entire JSON content of your service account key file here as a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ---- Server Configuration ----
PORT=3001

# ---- Frontend URL ----
# Your website URL (for Stripe redirect URLs)
FRONTEND_URL=https://www.georgiatrips.ge
